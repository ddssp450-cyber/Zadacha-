rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------- Shared Primitives ----------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidHash(h) {
      return h is string && h.size() == 64 && h.matches('^[a-f0-9]{64}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAnonymousUser() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function hasVerifiedEmailMatch(emailStr) {
      return isVerifiedUser()
        && ('email' in request.auth.token)
        && emailStr != ''
        && emailStr.lower() == request.auth.token.email.lower();
    }

    function isAdmin() {
      return isVerifiedUser() && ('email' in request.auth.token) && request.auth.token.email == 'ddssp450@gmail.com';
    }

    function isStr(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isNum(val) {
      return val is int || val is float;
    }

    function isIdList(arr, maxLen) {
      return arr is list && arr.size() <= maxLen && (arr.size() == 0 || (arr[0] is string && isValidId(arr[0])));
    }

    function isStrList(arr, maxLen, maxItemLen) {
      return arr is list && arr.size() <= maxLen && (arr.size() == 0 || (arr[0] is string && arr[0].size() <= maxItemLen));
    }

    function buildingDoc(buildingId) {
      return get(/databases/$(database)/documents/buildings/$(buildingId));
    }

    function buildingExists(buildingId) {
      return exists(/databases/$(database)/documents/buildings/$(buildingId));
    }

    function isBuildingOwner(buildingId) {
      return isVerifiedUser()
        && buildingExists(buildingId)
        && buildingDoc(buildingId).data.ownerId == request.auth.uid;
    }

    function memberPath(buildingId, uid) {
      return /databases/$(database)/documents/buildings/$(buildingId)/members/$(uid);
    }

    function isBuildingMember(buildingId) {
      return isSignedIn() && (
        isBuildingOwner(buildingId) ||
        exists(memberPath(buildingId, request.auth.uid))
      );
    }

    function memberRole(buildingId) {
      return isBuildingOwner(buildingId)
        ? 'owner'
        : (exists(memberPath(buildingId, request.auth.uid)) ? get(memberPath(buildingId, request.auth.uid)).data.role : '');
    }

    function memberApt(buildingId) {
      return exists(memberPath(buildingId, request.auth.uid))
        ? get(memberPath(buildingId, request.auth.uid)).data.apartmentNumber
        : '';
    }

    function hasClaimMatch(invData) {
      return ('lookupHashes' in invData)
        && exists(/databases/$(database)/documents/tenantClaims/$(request.auth.uid))
        && get(/databases/$(database)/documents/tenantClaims/$(request.auth.uid)).data.claimHashes.hasAny(invData.lookupHashes);
    }

    function isMemberSelfJoin(existingData, incomingData) {
      return !(request.auth.uid in existingData.memberUids)
        && request.auth.uid in incomingData.memberUids
        && incomingData.memberUids.hasAll(existingData.memberUids)
        && incomingData.memberUids.size() == existingData.memberUids.size() + 1
        && incomingData.diff(existingData).affectedKeys().hasOnly(['memberUids', 'updatedAt']);
    }

    function isAtomicExpenseCreate(buildingId, amount) {
      let beforeBal = buildingDoc(buildingId).data.reserveFundBalance;
      let afterBal = getAfter(/databases/$(database)/documents/buildings/$(buildingId)).data.reserveFundBalance;
      let diff = afterBal - (beforeBal - amount);
      return diff >= -0.01 && diff <= 0.01;
    }

    function isAtomicExpenseDelete(buildingId, amount) {
      let beforeBal = buildingDoc(buildingId).data.reserveFundBalance;
      let afterBal = getAfter(/databases/$(database)/documents/buildings/$(buildingId)).data.reserveFundBalance;
      let diff = afterBal - (beforeBal + amount);
      return diff >= -0.01 && diff <= 0.01;
    }

    // ---------- Validation Blueprints ----------
    function isValidUser(data, userId) {
      return data.keys().hasAll(['id', 'uid', 'name', 'email', 'phone', 'roleTitle', 'avatarUrl', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'uid', 'name', 'email', 'phone', 'roleTitle', 'companyName', 'avatarUrl', 'activeBuildingId', 'createdAt', 'updatedAt'])
        && isValidId(data.id) && data.id == userId
        && isValidId(data.uid) && data.uid == userId
        && isStr(data.name, 1, 120)
        && isStr(data.email, 0, 320)
        && isStr(data.phone, 0, 40)
        && isStr(data.roleTitle, 0, 160)
        && (!('companyName' in data) || isStr(data.companyName, 0, 160))
        && isStr(data.avatarUrl, 0, 1024)
        && (!('activeBuildingId' in data) || data.activeBuildingId == '' || isValidId(data.activeBuildingId))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBuilding(data, buildingId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'ownerEmail', 'memberUids', 'invitedEmails', 'name', 'address', 'city', 'postalCode',
          'totalFloors', 'totalApartments', 'occupiedApartments', 'yearBuilt',
          'reserveFundBalance', 'monthlyCollectionRate', 'exteriorImage', 'lobbyImage',
          'facilities', 'contactManager', 'phoneManager', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'ownerEmail', 'memberUids', 'invitedEmails', 'name', 'address', 'city', 'postalCode',
          'totalFloors', 'totalApartments', 'occupiedApartments', 'yearBuilt',
          'reserveFundBalance', 'monthlyCollectionRate', 'exteriorImage', 'lobbyImage',
          'facilities', 'contactManager', 'phoneManager', 'iban', 'bankName', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id) && data.id == buildingId
        && isValidId(data.ownerId)
        && isStr(data.ownerEmail, 3, 320)
        && isIdList(data.memberUids, 50)
        && isStrList(data.invitedEmails, 50, 320)
        && isStr(data.name, 1, 160)
        && isStr(data.address, 1, 240)
        && isStr(data.city, 1, 100)
        && isStr(data.postalCode, 0, 20)
        && data.totalFloors is int && data.totalFloors >= 1 && data.totalFloors <= 200
        && data.totalApartments is int && data.totalApartments >= 0 && data.totalApartments <= 5000
        && data.occupiedApartments is int && data.occupiedApartments >= 0 && data.occupiedApartments <= 5000
        && data.yearBuilt is int && data.yearBuilt >= 1800 && data.yearBuilt <= 2100
        && isNum(data.reserveFundBalance)
        && isNum(data.monthlyCollectionRate)
        && isStr(data.exteriorImage, 0, 500000)
        && isStr(data.lobbyImage, 0, 500000)
        && isStrList(data.facilities, 30, 200)
        && isStr(data.contactManager, 0, 120)
        && isStr(data.phoneManager, 0, 40)
        && (!('iban' in data) || isStr(data.iban, 0, 64))
        && (!('bankName' in data) || isStr(data.bankName, 0, 120))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMember(data, buildingId, memberUid) {
      return data.keys().hasAll(['uid', 'buildingId', 'ownerId', 'email', 'role', 'createdAt'])
        && data.keys().hasOnly(['uid', 'buildingId', 'ownerId', 'email', 'phone', 'name', 'role', 'apartmentNumber', 'inviteId', 'createdAt'])
        && isValidId(data.uid) && data.uid == memberUid
        && isValidId(data.buildingId) && data.buildingId == buildingId
        && isValidId(data.ownerId)
        && isStr(data.email, 0, 320)
        && (!('phone' in data) || isStr(data.phone, 0, 40))
        && (!('name' in data) || isStr(data.name, 0, 120))
        && data.role in ['owner', 'tenant', 'builder', 'craftsman']
        && (!('apartmentNumber' in data) || isStr(data.apartmentNumber, 0, 32))
        && (!('inviteId' in data) || isValidId(data.inviteId))
        && data.createdAt is timestamp;
    }

    function isValidInvite(data, inviteId) {
      return data.keys().hasAll(['id', 'buildingId', 'buildingName', 'ownerId', 'email', 'role', 'createdAt'])
        && data.keys().hasOnly([
          'id', 'buildingId', 'buildingName', 'ownerId', 'email', 'phone', 'name',
          'role', 'apartmentNumber', 'lookupHashes', 'claimedUids', 'authorizedDocs',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id) && data.id == inviteId
        && isValidId(data.buildingId)
        && isStr(data.buildingName, 1, 160)
        && isValidId(data.ownerId)
        && isStr(data.email, 0, 320)
        && (!('phone' in data) || isStr(data.phone, 0, 40))
        && (!('name' in data) || isStr(data.name, 0, 120))
        && data.role in ['tenant', 'builder', 'craftsman']
        && (!('apartmentNumber' in data) || isStr(data.apartmentNumber, 0, 32))
        && (!('lookupHashes' in data) || isStrList(data.lookupHashes, 20, 64))
        && (!('claimedUids' in data) || isIdList(data.claimedUids, 50))
        && (!('authorizedDocs' in data) || data.authorizedDocs is map)
        && data.createdAt is timestamp
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidInviteLookup(data, lookupHash) {
      return data.keys().hasAll(['id', 'inviteIds', 'updatedAt'])
        && data.keys().hasOnly(['id', 'inviteIds', 'updatedAt'])
        && isValidHash(data.id) && data.id == lookupHash
        && isIdList(data.inviteIds, 50)
        && data.updatedAt is timestamp;
    }

    function isValidTenantClaim(data, userId) {
      return data.keys().hasAll(['uid', 'claimHashes', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'claimHashes', 'updatedAt'])
        && isValidId(data.uid) && data.uid == userId
        && isStrList(data.claimHashes, 20, 64)
        && data.claimHashes.size() >= 1
        && data.updatedAt is timestamp;
    }

    function isValidApartment(data, buildingId, apartmentId) {
      return data.keys().hasAll([
          'id', 'buildingId', 'ownerId', 'memberUids', 'invitedEmails', 'number', 'floor', 'areaSqM', 'rooms',
          'status', 'monthlyRent', 'monthlyMaintenanceFee', 'waterMeterReading', 'electricMeterReading',
          'lastMeterUpdate', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'buildingId', 'ownerId', 'memberUids', 'invitedEmails', 'number', 'floor', 'entrance', 'areaSqM', 'rooms',
          'tenantId', 'tenantName', 'tenantPhone', 'status', 'monthlyRent', 'monthlyMaintenanceFee',
          'waterMeterReading', 'electricMeterReading', 'lastMeterUpdate', 'updatedAt'
        ])
        && isValidId(data.id) && data.id == apartmentId
        && isValidId(data.buildingId) && data.buildingId == buildingId
        && isValidId(data.ownerId)
        && isIdList(data.memberUids, 50)
        && isStrList(data.invitedEmails, 50, 320)
        && isStr(data.number, 1, 32)
        && data.floor is int
        && (!('entrance' in data) || isStr(data.entrance, 0, 32))
        && isNum(data.areaSqM)
        && data.rooms is int
        && (!('tenantId' in data) || isStr(data.tenantId, 0, 128))
        && (!('tenantName' in data) || isStr(data.tenantName, 0, 120))
        && (!('tenantPhone' in data) || isStr(data.tenantPhone, 0, 40))
        && data.status in ['occupied', 'vacant', 'under_repair']
        && isNum(data.monthlyRent)
        && isNum(data.monthlyMaintenanceFee)
        && isNum(data.waterMeterReading)
        && isNum(data.electricMeterReading)
        && isStr(data.lastMeterUpdate, 0, 32)
        && data.updatedAt is timestamp;
    }

    function isValidPayment(data, buildingId, paymentId) {
      return data.keys().hasAll([
          'id', 'buildingId', 'ownerId', 'memberUids', 'invitedEmails', 'apartmentId', 'apartmentNumber',
          'tenantId', 'tenantName', 'title', 'type', 'amount', 'dueDate', 'period', 'status', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'buildingId', 'ownerId', 'memberUids', 'invitedEmails', 'apartmentId', 'apartmentNumber',
          'tenantId', 'tenantName', 'title', 'type', 'amount', 'dueDate', 'period', 'status',
          'paidAmount', 'paidAt', 'proofUrl', 'proofType', 'proofExtractedData',
          'confirmedByOwnerAt', 'rejectedReason', 'notes', 'updatedAt'
        ])
        && isValidId(data.id) && data.id == paymentId
        && isValidId(data.buildingId) && data.buildingId == buildingId
        && isValidId(data.ownerId)
        && isIdList(data.memberUids, 50)
        && isStrList(data.invitedEmails, 50, 320)
        && isStr(data.apartmentId, 0, 128)
        && isStr(data.apartmentNumber, 0, 32)
        && isStr(data.tenantId, 0, 128)
        && isStr(data.tenantName, 0, 120)
        && isStr(data.title, 1, 200)
        && data.type in ['rent', 'electricity', 'water', 'common_fund', 'repair_fund']
        && isNum(data.amount)
        && isStr(data.dueDate, 0, 32)
        && isStr(data.period, 0, 64)
        && data.status in ['unpaid', 'declared_paid', 'pending_verification', 'confirmed_paid', 'partially_paid', 'overdue']
        && (!('paidAmount' in data) || isNum(data.paidAmount))
        && (!('paidAt' in data) || isStr(data.paidAt, 0, 64))
        && (!('proofUrl' in data) || isStr(data.proofUrl, 0, 600000))
        && (!('proofType' in data) || data.proofType in ['image', 'pdf'])
        && (!('proofExtractedData' in data) || data.proofExtractedData is map)
        && (!('confirmedByOwnerAt' in data) || isStr(data.confirmedByOwnerAt, 0, 64))
        && (!('rejectedReason' in data) || isStr(data.rejectedReason, 0, 500))
        && (!('notes' in data) || isStr(data.notes, 0, 1000))
        && data.updatedAt is timestamp;
    }

    function isValidAppliance(data, buildingId, applianceId) {
      return data.keys().hasAll([
          'id', 'buildingId', 'ownerId', 'memberUids', 'invitedEmails', 'locationName', 'name', 'category',
          'model', 'manufacturer', 'serialNumber', 'installationDate', 'warrantyExpiryDate',
          'status', 'lastServicedAt', 'nextMaintenanceDue', 'photoUrl', 'serviceHistory', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'buildingId', 'ownerId', 'memberUids', 'invitedEmails', 'apartmentId', 'locationName', 'name', 'category',
          'model', 'manufacturer', 'serialNumber', 'installationDate', 'warrantyExpiryDate',
          'status', 'lastServicedAt', 'nextMaintenanceDue', 'photoUrl', 'manualUrl', 'energyClass',
          'serviceHistory', 'updatedAt'
        ])
        && isValidId(data.id) && data.id == applianceId
        && isValidId(data.buildingId) && data.buildingId == buildingId
        && isValidId(data.ownerId)
        && isIdList(data.memberUids, 50)
        && isStrList(data.invitedEmails, 50, 320)
        && (!('apartmentId' in data) || isStr(data.apartmentId, 0, 128))
        && isStr(data.locationName, 0, 160)
        && isStr(data.name, 1, 160)
        && data.category in ['hvac', 'boiler', 'elevator', 'intercom', 'hydrophore', 'generator']
        && isStr(data.model, 0, 160)
        && isStr(data.manufacturer, 0, 120)
        && isStr(data.serialNumber, 0, 120)
        && isStr(data.installationDate, 0, 32)
        && isStr(data.warrantyExpiryDate, 0, 32)
        && data.status in ['operational', 'needs_service', 'critical_issue', 'decommissioned']
        && isStr(data.lastServicedAt, 0, 32)
        && isStr(data.nextMaintenanceDue, 0, 32)
        && isStr(data.photoUrl, 0, 500000)
        && (!('manualUrl' in data) || isStr(data.manualUrl, 0, 1024))
        && (!('energyClass' in data) || isStr(data.energyClass, 0, 32))
        && data.serviceHistory is list && data.serviceHistory.size() <= 100
        && (data.serviceHistory.size() == 0 || data.serviceHistory[0] is map)
        && data.updatedAt is timestamp;
    }

    function isValidRepairTicket(data, buildingId, ticketId) {
      return data.keys().hasAll([
          'id', 'buildingId', 'ownerId', 'createdByUid', 'memberUids', 'invitedEmails', 'ticketNumber', 'title',
          'description', 'category', 'priority', 'status', 'reporterRole', 'reporterName',
          'estimatedBudget', 'reportedDate', 'deadlineDate', 'locationDetail', 'beforePhotos', 'afterPhotos', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'buildingId', 'ownerId', 'createdByUid', 'memberUids', 'invitedEmails', 'ticketNumber', 'title',
          'description', 'category', 'priority', 'status', 'apartmentId', 'apartmentNumber',
          'reporterRole', 'reporterName', 'assignedCraftsmanId', 'assignedCraftsmanName',
          'assignedBuilderName', 'estimatedBudget', 'approvedBudget', 'actualCost',
          'reportedDate', 'deadlineDate', 'scheduledVisitDate', 'completedDate',
          'locationDetail', 'beforePhotos', 'afterPhotos', 'materialsUsed',
          'technicianNotes', 'ownerApprovalNotes', 'updatedAt'
        ])
        && isValidId(data.id) && data.id == ticketId
        && isValidId(data.buildingId) && data.buildingId == buildingId
        && isValidId(data.ownerId)
        && isValidId(data.createdByUid)
        && isIdList(data.memberUids, 50)
        && isStrList(data.invitedEmails, 50, 320)
        && isStr(data.ticketNumber, 1, 64)
        && isStr(data.title, 1, 200)
        && isStr(data.description, 0, 4000)
        && data.category in ['plumbing', 'electrical', 'hvac', 'common_area', 'construction_defect', 'elevator']
        && data.priority in ['urgent', 'high', 'medium', 'low']
        && data.status in ['reported', 'approved', 'scheduled', 'in_progress', 'completed', 'rejected']
        && (!('apartmentId' in data) || isStr(data.apartmentId, 0, 128))
        && (!('apartmentNumber' in data) || isStr(data.apartmentNumber, 0, 32))
        && data.reporterRole in ['owner', 'tenant', 'builder', 'craftsman']
        && isStr(data.reporterName, 1, 120)
        && (!('assignedCraftsmanId' in data) || isStr(data.assignedCraftsmanId, 0, 128))
        && (!('assignedCraftsmanName' in data) || isStr(data.assignedCraftsmanName, 0, 120))
        && (!('assignedBuilderName' in data) || isStr(data.assignedBuilderName, 0, 120))
        && isNum(data.estimatedBudget)
        && (!('approvedBudget' in data) || isNum(data.approvedBudget))
        && (!('actualCost' in data) || isNum(data.actualCost))
        && isStr(data.reportedDate, 0, 32)
        && isStr(data.deadlineDate, 0, 32)
        && (!('scheduledVisitDate' in data) || isStr(data.scheduledVisitDate, 0, 32))
        && (!('completedDate' in data) || isStr(data.completedDate, 0, 32))
        && isStr(data.locationDetail, 0, 240)
        && isStrList(data.beforePhotos, 10, 400000)
        && isStrList(data.afterPhotos, 10, 400000)
        && (!('materialsUsed' in data) || isStrList(data.materialsUsed, 30, 200))
        && (!('technicianNotes' in data) || isStr(data.technicianNotes, 0, 2000))
        && (!('ownerApprovalNotes' in data) || isStr(data.ownerApprovalNotes, 0, 2000))
        && data.updatedAt is timestamp;
    }

    function isValidDefect(data, buildingId, defectId) {
      return data.keys().hasAll([
          'id', 'buildingId', 'ownerId', 'memberUids', 'invitedEmails', 'defectNumber', 'title', 'location',
          'severity', 'status', 'reportedBy', 'reportedAt', 'deadline', 'contractorName',
          'photos', 'actionPlan', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'buildingId', 'ownerId', 'memberUids', 'invitedEmails', 'defectNumber', 'title', 'location',
          'severity', 'status', 'reportedBy', 'reportedAt', 'deadline', 'contractorName',
          'photos', 'actionPlan', 'verifiedAt', 'updatedAt'
        ])
        && isValidId(data.id) && data.id == defectId
        && isValidId(data.buildingId) && data.buildingId == buildingId
        && isValidId(data.ownerId)
        && isIdList(data.memberUids, 50)
        && isStrList(data.invitedEmails, 50, 320)
        && isStr(data.defectNumber, 1, 64)
        && isStr(data.title, 1, 200)
        && isStr(data.location, 0, 240)
        && data.severity in ['cosmetic', 'structural', 'isolation', 'finishing']
        && data.status in ['open', 'fixing', 'verified_fixed']
        && isStr(data.reportedBy, 1, 120)
        && isStr(data.reportedAt, 0, 32)
        && isStr(data.deadline, 0, 32)
        && isStr(data.contractorName, 0, 160)
        && isStrList(data.photos, 10, 400000)
        && isStr(data.actionPlan, 0, 2000)
        && (!('verifiedAt' in data) || isStr(data.verifiedAt, 0, 64))
        && data.updatedAt is timestamp;
    }

    function isValidCalendarEvent(data, buildingId, eventId) {
      return data.keys().hasAll([
          'id', 'buildingId', 'ownerId', 'memberUids', 'invitedEmails', 'title', 'category', 'startDateTime',
          'endDateTime', 'assignedToName', 'assignedRole', 'status', 'description', 'priority', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'buildingId', 'ownerId', 'memberUids', 'invitedEmails', 'title', 'category', 'startDateTime',
          'endDateTime', 'apartmentNumber', 'assignedToName', 'assignedRole', 'status',
          'description', 'priority', 'isRecurring', 'recurrenceRule', 'updatedAt'
        ])
        && isValidId(data.id) && data.id == eventId
        && isValidId(data.buildingId) && data.buildingId == buildingId
        && isValidId(data.ownerId)
        && isIdList(data.memberUids, 50)
        && isStrList(data.invitedEmails, 50, 320)
        && isStr(data.title, 1, 200)
        && data.category in ['rent_deadline', 'repair', 'construction', 'inspection', 'maintenance', 'cleaning', 'meeting']
        && isStr(data.startDateTime, 1, 64)
        && isStr(data.endDateTime, 1, 64)
        && (!('apartmentNumber' in data) || isStr(data.apartmentNumber, 0, 32))
        && isStr(data.assignedToName, 0, 120)
        && data.assignedRole in ['owner', 'tenant', 'builder', 'craftsman', 'all']
        && data.status in ['pending', 'in_progress', 'completed', 'cancelled']
        && isStr(data.description, 0, 2000)
        && data.priority in ['urgent', 'high', 'normal']
        && (!('isRecurring' in data) || data.isRecurring is bool)
        && (!('recurrenceRule' in data) || isStr(data.recurrenceRule, 0, 120))
        && data.updatedAt is timestamp;
    }

    function isValidExpense(data, buildingId, expenseId) {
      return data.keys().hasAll([
          'id', 'buildingId', 'ownerId', 'memberUids', 'title', 'category', 'amount', 'date',
          'vendor', 'invoiceNumber', 'status', 'approvedByOwner', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'buildingId', 'ownerId', 'memberUids', 'title', 'category', 'amount', 'date',
          'vendor', 'invoiceNumber', 'status', 'approvedByOwner', 'documentUrl', 'updatedAt'
        ])
        && isValidId(data.id) && data.id == expenseId
        && isValidId(data.buildingId) && data.buildingId == buildingId
        && isValidId(data.ownerId)
        && isIdList(data.memberUids, 50)
        && isStr(data.title, 1, 200)
        && data.category in ['cleaning', 'elevator_service', 'landscaping', 'security', 'repair', 'utilities']
        && isNum(data.amount) && data.amount >= 0
        && isStr(data.date, 0, 32)
        && isStr(data.vendor, 0, 160)
        && isStr(data.invoiceNumber, 0, 80)
        && data.status in ['pending_approval', 'approved', 'paid']
        && data.approvedByOwner is bool
        && (!('documentUrl' in data) || isStr(data.documentUrl, 0, 600000))
        && data.updatedAt is timestamp;
    }

    // ---------- Collections ----------
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUser(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (isVerifiedUser() && incoming().email == request.auth.token.email) ||
          (isAnonymousUser() && incoming().email == '')
        );
      allow update: if isSignedIn()
        && isValidId(userId)
        && isValidUser(incoming(), userId)
        && incoming().id == existing().id
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'roleTitle', 'companyName', 'avatarUrl', 'activeBuildingId', 'updatedAt']))
        );
      allow delete: if isAdmin() && isValidId(userId);
    }

    match /tenantClaims/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidTenantClaim(incoming(), userId)
        && incoming().updatedAt == request.time;
      allow delete: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
    }

    match /inviteLookups/{lookupHash} {
      allow get: if isSignedIn() && isValidHash(lookupHash);
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidHash(lookupHash)
        && isValidInviteLookup(incoming(), lookupHash)
        && incoming().inviteIds.size() == 1
        && existsAfter(/databases/$(database)/documents/invites/$(incoming().inviteIds[0]))
        && getAfter(/databases/$(database)/documents/invites/$(incoming().inviteIds[0])).data.ownerId == request.auth.uid
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidHash(lookupHash)
        && isValidInviteLookup(incoming(), lookupHash)
        && incoming().id == existing().id
        && incoming().updatedAt == request.time
        && (
          (incoming().inviteIds.hasAll(existing().inviteIds) && incoming().inviteIds.size() <= existing().inviteIds.size() + 1) ||
          existing().inviteIds.hasAll(incoming().inviteIds)
        );
      allow delete: if isAdmin() || (isVerifiedUser() && isValidHash(lookupHash) && existing().inviteIds.size() <= 1);
    }

    match /invites/{inviteId} {
      allow get: if isSignedIn() && isValidId(inviteId) && (
        hasVerifiedEmailMatch(existing().email) ||
        (isVerifiedUser() && existing().ownerId == request.auth.uid) ||
        hasClaimMatch(existing()) ||
        isAdmin()
      );
      allow list: if isVerifiedUser() && (
        hasVerifiedEmailMatch(resource.data.email) ||
        resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isVerifiedUser()
        && isValidId(inviteId)
        && isValidInvite(incoming(), inviteId)
        && incoming().ownerId == request.auth.uid
        && isBuildingOwner(incoming().buildingId)
        && incoming().createdAt == request.time;
      allow update: if isSignedIn()
        && isValidId(inviteId)
        && isValidInvite(incoming(), inviteId)
        && incoming().id == existing().id
        && incoming().buildingId == existing().buildingId
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && (
          isAdmin() ||
          (
            isVerifiedUser() &&
            existing().ownerId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['authorizedDocs', 'lookupHashes', 'updatedAt'])
          ) ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['claimedUids', 'updatedAt']) &&
            request.auth.uid in incoming().claimedUids &&
            (!('claimedUids' in existing()) || incoming().claimedUids.hasAll(existing().claimedUids)) &&
            (hasVerifiedEmailMatch(existing().email) || hasClaimMatch(existing()))
          )
        );
      allow delete: if isVerifiedUser() && isValidId(inviteId) && (
        existing().ownerId == request.auth.uid ||
        hasVerifiedEmailMatch(existing().email) ||
        isAdmin()
      );
    }

    match /buildings/{buildingId} {
      allow get: if isSignedIn() && isValidId(buildingId) && (
        existing().ownerId == request.auth.uid ||
        request.auth.uid in existing().memberUids ||
        (isVerifiedUser() && ('email' in request.auth.token) && request.auth.token.email.lower() in existing().invitedEmails) ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        request.auth.uid in resource.data.memberUids ||
        (isVerifiedUser() && ('email' in request.auth.token) && request.auth.token.email.lower() in resource.data.invitedEmails) ||
        isAdmin()
      );
      allow create: if isVerifiedUser()
        && isValidId(buildingId)
        && isValidBuilding(incoming(), buildingId)
        && incoming().ownerId == request.auth.uid
        && incoming().ownerEmail == request.auth.token.email
        && request.auth.uid in incoming().memberUids
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(buildingId)
        && isValidBuilding(incoming(), buildingId)
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().ownerEmail == existing().ownerEmail
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isVerifiedUser() &&
            existing().ownerId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'address', 'city', 'postalCode', 'totalFloors', 'totalApartments',
              'occupiedApartments', 'yearBuilt', 'reserveFundBalance', 'monthlyCollectionRate',
              'exteriorImage', 'lobbyImage', 'facilities', 'contactManager', 'phoneManager',
              'iban', 'bankName', 'memberUids', 'invitedEmails', 'updatedAt'
            ])
          ) ||
          (
            // Invited/claimed user joining the building via a valid invite
            isMemberSelfJoin(existing(), incoming()) &&
            existsAfter(memberPath(buildingId, request.auth.uid))
          )
        );
      allow delete: if isVerifiedUser() && isValidId(buildingId) && (
        existing().ownerId == request.auth.uid || isAdmin()
      );

      match /members/{memberUid} {
        allow get: if isSignedIn() && isValidId(buildingId) && isValidId(memberUid) && (
          isBuildingOwner(buildingId) || request.auth.uid == memberUid || isAdmin()
        );
        allow list: if isSignedIn() && (
          resource.data.ownerId == request.auth.uid ||
          resource.data.uid == request.auth.uid ||
          isAdmin()
        );
        allow create: if isSignedIn()
          && isValidId(buildingId) && isValidId(memberUid)
          && isValidMember(incoming(), buildingId, memberUid)
          && incoming().createdAt == request.time
          && (
            (isBuildingOwner(buildingId) && incoming().ownerId == request.auth.uid) ||
            (
              // Owner bootstrapping their own owner record during building creation batch
              isVerifiedUser() &&
              memberUid == request.auth.uid &&
              incoming().role == 'owner' &&
              incoming().ownerId == request.auth.uid &&
              existsAfter(/databases/$(database)/documents/buildings/$(buildingId)) &&
              getAfter(/databases/$(database)/documents/buildings/$(buildingId)).data.ownerId == request.auth.uid
            ) ||
            (
              // Invited user claiming an existing invite matching their verified email
              isVerifiedUser() &&
              memberUid == request.auth.uid &&
              ('inviteId' in incoming()) &&
              exists(/databases/$(database)/documents/invites/$(incoming().inviteId)) &&
              hasVerifiedEmailMatch(get(/databases/$(database)/documents/invites/$(incoming().inviteId)).data.email) &&
              get(/databases/$(database)/documents/invites/$(incoming().inviteId)).data.buildingId == buildingId &&
              get(/databases/$(database)/documents/invites/$(incoming().inviteId)).data.role == incoming().role &&
              incoming().email.lower() == request.auth.token.email.lower()
            ) ||
            (
              // Tenant/member claiming an invite via hashed lookup proof (/tenantClaims/{uid})
              memberUid == request.auth.uid &&
              ('inviteId' in incoming()) &&
              exists(/databases/$(database)/documents/invites/$(incoming().inviteId)) &&
              hasClaimMatch(get(/databases/$(database)/documents/invites/$(incoming().inviteId)).data) &&
              get(/databases/$(database)/documents/invites/$(incoming().inviteId)).data.buildingId == buildingId &&
              get(/databases/$(database)/documents/invites/$(incoming().inviteId)).data.role == incoming().role
            )
          );
        allow update: if isVerifiedUser()
          && isValidId(buildingId) && isValidId(memberUid)
          && isValidMember(incoming(), buildingId, memberUid)
          && incoming().uid == existing().uid
          && incoming().buildingId == existing().buildingId
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && (
            isAdmin() ||
            (isBuildingOwner(buildingId) && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'apartmentNumber', 'name', 'phone']))
          );
        allow delete: if isVerifiedUser() && isValidId(buildingId) && isValidId(memberUid) && (
          (isBuildingOwner(buildingId) && (existing().role != 'owner' || !existsAfter(/databases/$(database)/documents/buildings/$(buildingId)))) ||
          isAdmin()
        );
      }

      match /apartments/{apartmentId} {
        allow get: if isSignedIn() && isValidId(buildingId) && isValidId(apartmentId) && (
          isBuildingOwner(buildingId) ||
          memberRole(buildingId) in ['builder', 'craftsman'] ||
          (memberRole(buildingId) == 'tenant' && existing().number == memberApt(buildingId)) ||
          isAdmin()
        );
        allow list: if isSignedIn() && (
          resource.data.ownerId == request.auth.uid ||
          request.auth.uid in resource.data.memberUids ||
          (isVerifiedUser() && ('email' in request.auth.token) && request.auth.token.email.lower() in resource.data.invitedEmails) ||
          isAdmin()
        );
        allow create: if isVerifiedUser()
          && isValidId(buildingId) && isValidId(apartmentId)
          && isValidApartment(incoming(), buildingId, apartmentId)
          && incoming().updatedAt == request.time
          && (isBuildingOwner(buildingId) || isAdmin());
        allow update: if isSignedIn()
          && isValidId(buildingId) && isValidId(apartmentId)
          && isValidApartment(incoming(), buildingId, apartmentId)
          && incoming().id == existing().id
          && incoming().buildingId == existing().buildingId
          && incoming().ownerId == existing().ownerId
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            (
              isBuildingOwner(buildingId) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'number', 'floor', 'entrance', 'areaSqM', 'rooms', 'tenantId', 'tenantName', 'tenantPhone',
                'status', 'monthlyRent', 'monthlyMaintenanceFee', 'waterMeterReading', 'electricMeterReading',
                'lastMeterUpdate', 'memberUids', 'invitedEmails', 'updatedAt'
              ])
            ) ||
            (
              memberRole(buildingId) == 'tenant' &&
              existing().number == memberApt(buildingId) &&
              incoming().diff(existing()).affectedKeys().hasOnly(['waterMeterReading', 'electricMeterReading', 'lastMeterUpdate', 'updatedAt'])
            ) ||
            (
              isBuildingMember(buildingId) &&
              isMemberSelfJoin(existing(), incoming()) &&
              (memberRole(buildingId) in ['builder', 'craftsman'] || (memberRole(buildingId) == 'tenant' && existing().number == memberApt(buildingId)))
            )
          );
        allow delete: if isVerifiedUser() && isValidId(buildingId) && isValidId(apartmentId) && (
          isBuildingOwner(buildingId) || isAdmin()
        );
      }

      match /payments/{paymentId} {
        allow get: if isSignedIn() && isValidId(buildingId) && isValidId(paymentId) && (
          isBuildingOwner(buildingId) ||
          (memberRole(buildingId) == 'tenant' && existing().apartmentNumber == memberApt(buildingId)) ||
          isAdmin()
        );
        allow list: if isSignedIn() && (
          resource.data.ownerId == request.auth.uid ||
          request.auth.uid in resource.data.memberUids ||
          (isVerifiedUser() && ('email' in request.auth.token) && request.auth.token.email.lower() in resource.data.invitedEmails) ||
          isAdmin()
        );
        allow create: if isVerifiedUser()
          && isValidId(buildingId) && isValidId(paymentId)
          && isValidPayment(incoming(), buildingId, paymentId)
          && incoming().updatedAt == request.time
          && (isBuildingOwner(buildingId) || isAdmin());
        allow update: if isSignedIn()
          && isValidId(buildingId) && isValidId(paymentId)
          && isValidPayment(incoming(), buildingId, paymentId)
          && incoming().id == existing().id
          && incoming().buildingId == existing().buildingId
          && incoming().ownerId == existing().ownerId
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            (
              existing().status != 'confirmed_paid' &&
              isBuildingOwner(buildingId) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'title', 'type', 'amount', 'dueDate', 'period', 'status', 'paidAmount', 'paidAt',
                'proofUrl', 'proofType', 'proofExtractedData', 'confirmedByOwnerAt', 'rejectedReason', 'notes', 'memberUids', 'invitedEmails', 'updatedAt'
              ])
            ) ||
            (
              existing().status != 'confirmed_paid' &&
              memberRole(buildingId) == 'tenant' &&
              existing().apartmentNumber == memberApt(buildingId) &&
              incoming().status == 'pending_verification' &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'status', 'paidAmount', 'paidAt', 'proofUrl', 'proofType', 'proofExtractedData', 'updatedAt'
              ])
            ) ||
            (
              isBuildingMember(buildingId) &&
              isMemberSelfJoin(existing(), incoming()) &&
              memberRole(buildingId) == 'tenant' &&
              existing().apartmentNumber == memberApt(buildingId)
            )
          );
        allow delete: if isVerifiedUser() && isValidId(buildingId) && isValidId(paymentId) && (
          isBuildingOwner(buildingId) || isAdmin()
        );
      }

      match /appliances/{applianceId} {
        allow get: if isSignedIn() && isValidId(buildingId) && isValidId(applianceId) && (
          isBuildingMember(buildingId) || isAdmin()
        );
        allow list: if isSignedIn() && (
          resource.data.ownerId == request.auth.uid ||
          request.auth.uid in resource.data.memberUids ||
          (isVerifiedUser() && ('email' in request.auth.token) && request.auth.token.email.lower() in resource.data.invitedEmails) ||
          isAdmin()
        );
        allow create: if isVerifiedUser()
          && isValidId(buildingId) && isValidId(applianceId)
          && isValidAppliance(incoming(), buildingId, applianceId)
          && incoming().updatedAt == request.time
          && (isBuildingOwner(buildingId) || isAdmin());
        allow update: if isSignedIn()
          && isValidId(buildingId) && isValidId(applianceId)
          && isValidAppliance(incoming(), buildingId, applianceId)
          && incoming().id == existing().id
          && incoming().buildingId == existing().buildingId
          && incoming().ownerId == existing().ownerId
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            (
              isBuildingOwner(buildingId) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'apartmentId', 'locationName', 'name', 'category', 'model', 'manufacturer', 'serialNumber',
                'installationDate', 'warrantyExpiryDate', 'status', 'lastServicedAt', 'nextMaintenanceDue',
                'photoUrl', 'manualUrl', 'energyClass', 'serviceHistory', 'memberUids', 'invitedEmails', 'updatedAt'
              ])
            ) ||
            (
              memberRole(buildingId) in ['builder', 'craftsman'] &&
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'lastServicedAt', 'serviceHistory', 'updatedAt'])
            ) ||
            (
              isBuildingMember(buildingId) &&
              isMemberSelfJoin(existing(), incoming())
            )
          );
        allow delete: if isVerifiedUser() && isValidId(buildingId) && isValidId(applianceId) && (
          isBuildingOwner(buildingId) || isAdmin()
        );
      }

      match /repairTickets/{ticketId} {
        allow get: if isSignedIn() && isValidId(buildingId) && isValidId(ticketId) && (
          isBuildingOwner(buildingId) ||
          memberRole(buildingId) in ['builder', 'craftsman'] ||
          (memberRole(buildingId) == 'tenant' && (!('apartmentNumber' in existing()) || existing().apartmentNumber == '' || existing().apartmentNumber == memberApt(buildingId))) ||
          isAdmin()
        );
        allow list: if isSignedIn() && (
          resource.data.ownerId == request.auth.uid ||
          request.auth.uid in resource.data.memberUids ||
          (isVerifiedUser() && ('email' in request.auth.token) && request.auth.token.email.lower() in resource.data.invitedEmails) ||
          isAdmin()
        );
        allow create: if isSignedIn()
          && isValidId(buildingId) && isValidId(ticketId)
          && isValidRepairTicket(incoming(), buildingId, ticketId)
          && incoming().createdByUid == request.auth.uid
          && incoming().updatedAt == request.time
          && (
            isBuildingOwner(buildingId) ||
            memberRole(buildingId) in ['builder', 'craftsman'] ||
            (memberRole(buildingId) == 'tenant' && incoming().status == 'reported' && (!('apartmentNumber' in incoming()) || incoming().apartmentNumber == '' || incoming().apartmentNumber == memberApt(buildingId))) ||
            isAdmin()
          );
        allow update: if isSignedIn()
          && isValidId(buildingId) && isValidId(ticketId)
          && isValidRepairTicket(incoming(), buildingId, ticketId)
          && incoming().id == existing().id
          && incoming().buildingId == existing().buildingId
          && incoming().ownerId == existing().ownerId
          && incoming().createdByUid == existing().createdByUid
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            (
              !(existing().status in ['completed', 'rejected']) &&
              isBuildingOwner(buildingId) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'title', 'description', 'category', 'priority', 'status', 'assignedCraftsmanId',
                'assignedCraftsmanName', 'assignedBuilderName', 'estimatedBudget', 'approvedBudget',
                'actualCost', 'deadlineDate', 'scheduledVisitDate', 'completedDate', 'locationDetail',
                'beforePhotos', 'afterPhotos', 'materialsUsed', 'technicianNotes', 'ownerApprovalNotes', 'memberUids', 'invitedEmails', 'updatedAt'
              ])
            ) ||
            (
              !(existing().status in ['completed', 'rejected']) &&
              memberRole(buildingId) in ['builder', 'craftsman'] &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'status', 'actualCost', 'scheduledVisitDate', 'completedDate', 'afterPhotos', 'materialsUsed', 'technicianNotes', 'updatedAt'
              ])
            ) ||
            (
              isBuildingMember(buildingId) &&
              isMemberSelfJoin(existing(), incoming()) &&
              (
                memberRole(buildingId) in ['builder', 'craftsman'] ||
                (memberRole(buildingId) == 'tenant' && (!('apartmentNumber' in existing()) || existing().apartmentNumber == '' || existing().apartmentNumber == memberApt(buildingId)))
              )
            )
          );
        allow delete: if isVerifiedUser() && isValidId(buildingId) && isValidId(ticketId) && (
          isBuildingOwner(buildingId) || isAdmin()
        );
      }

      match /defects/{defectId} {
        allow get: if isSignedIn() && isValidId(buildingId) && isValidId(defectId) && (
          isBuildingOwner(buildingId) || memberRole(buildingId) == 'builder' || isAdmin()
        );
        allow list: if isSignedIn() && (
          resource.data.ownerId == request.auth.uid ||
          request.auth.uid in resource.data.memberUids ||
          (isVerifiedUser() && ('email' in request.auth.token) && request.auth.token.email.lower() in resource.data.invitedEmails) ||
          isAdmin()
        );
        allow create: if isSignedIn()
          && isValidId(buildingId) && isValidId(defectId)
          && isValidDefect(incoming(), buildingId, defectId)
          && incoming().updatedAt == request.time
          && (isBuildingOwner(buildingId) || memberRole(buildingId) == 'builder' || isAdmin());
        allow update: if isSignedIn()
          && isValidId(buildingId) && isValidId(defectId)
          && isValidDefect(incoming(), buildingId, defectId)
          && incoming().id == existing().id
          && incoming().buildingId == existing().buildingId
          && incoming().ownerId == existing().ownerId
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            (
              existing().status != 'verified_fixed' &&
              isBuildingOwner(buildingId) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'title', 'location', 'severity', 'status', 'deadline', 'contractorName', 'photos', 'actionPlan', 'verifiedAt', 'memberUids', 'invitedEmails', 'updatedAt'
              ])
            ) ||
            (
              existing().status != 'verified_fixed' &&
              memberRole(buildingId) == 'builder' &&
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'photos', 'actionPlan', 'verifiedAt', 'updatedAt'])
            ) ||
            (
              isBuildingMember(buildingId) &&
              isMemberSelfJoin(existing(), incoming()) &&
              memberRole(buildingId) == 'builder'
            )
          );
        allow delete: if isVerifiedUser() && isValidId(buildingId) && isValidId(defectId) && (
          isBuildingOwner(buildingId) || isAdmin()
        );
      }

      match /calendarEvents/{eventId} {
        allow get: if isSignedIn() && isValidId(buildingId) && isValidId(eventId) && (
          isBuildingOwner(buildingId) ||
          memberRole(buildingId) in ['builder', 'craftsman'] ||
          (memberRole(buildingId) == 'tenant' && (existing().assignedRole in ['all', 'tenant'] || existing().apartmentNumber == memberApt(buildingId))) ||
          isAdmin()
        );
        allow list: if isSignedIn() && (
          resource.data.ownerId == request.auth.uid ||
          request.auth.uid in resource.data.memberUids ||
          (isVerifiedUser() && ('email' in request.auth.token) && request.auth.token.email.lower() in resource.data.invitedEmails) ||
          isAdmin()
        );
        allow create: if isSignedIn()
          && isValidId(buildingId) && isValidId(eventId)
          && isValidCalendarEvent(incoming(), buildingId, eventId)
          && incoming().updatedAt == request.time
          && (isBuildingOwner(buildingId) || memberRole(buildingId) in ['builder', 'craftsman'] || isAdmin());
        allow update: if isSignedIn()
          && isValidId(buildingId) && isValidId(eventId)
          && isValidCalendarEvent(incoming(), buildingId, eventId)
          && incoming().id == existing().id
          && incoming().buildingId == existing().buildingId
          && incoming().ownerId == existing().ownerId
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            (
              isBuildingOwner(buildingId) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'title', 'category', 'startDateTime', 'endDateTime', 'apartmentNumber', 'assignedToName',
                'assignedRole', 'status', 'description', 'priority', 'isRecurring', 'recurrenceRule', 'memberUids', 'invitedEmails', 'updatedAt'
              ])
            ) ||
            (
              memberRole(buildingId) in ['builder', 'craftsman'] &&
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'description', 'updatedAt'])
            ) ||
            (
              isBuildingMember(buildingId) &&
              isMemberSelfJoin(existing(), incoming()) &&
              (
                memberRole(buildingId) in ['builder', 'craftsman'] ||
                (memberRole(buildingId) == 'tenant' && (existing().assignedRole in ['all', 'tenant'] || existing().apartmentNumber == memberApt(buildingId)))
              )
            )
          );
        allow delete: if isVerifiedUser() && isValidId(buildingId) && isValidId(eventId) && (
          isBuildingOwner(buildingId) || isAdmin()
        );
      }

      match /expenses/{expenseId} {
        allow get: if isVerifiedUser() && isValidId(buildingId) && isValidId(expenseId) && (
          isBuildingOwner(buildingId) || isAdmin()
        );
        allow list: if isVerifiedUser() && (
          resource.data.ownerId == request.auth.uid ||
          isAdmin()
        );
        allow create: if isVerifiedUser()
          && isValidId(buildingId) && isValidId(expenseId)
          && isValidExpense(incoming(), buildingId, expenseId)
          && incoming().updatedAt == request.time
          && (isBuildingOwner(buildingId) || isAdmin())
          && isAtomicExpenseCreate(buildingId, incoming().amount);
        allow update: if isVerifiedUser()
          && isValidId(buildingId) && isValidId(expenseId)
          && isValidExpense(incoming(), buildingId, expenseId)
          && incoming().id == existing().id
          && incoming().buildingId == existing().buildingId
          && incoming().ownerId == existing().ownerId
          && incoming().amount == existing().amount
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            (
              isBuildingOwner(buildingId) &&
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'approvedByOwner', 'documentUrl', 'updatedAt'])
            )
          );
        allow delete: if isVerifiedUser()
          && isValidId(buildingId) && isValidId(expenseId)
          && (isBuildingOwner(buildingId) || isAdmin())
          && (
            !existsAfter(/databases/$(database)/documents/buildings/$(buildingId)) ||
            isAtomicExpenseDelete(buildingId, existing().amount)
          );
      }
    }
  }
}
