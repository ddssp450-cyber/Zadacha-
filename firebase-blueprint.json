        "reporterRole": { "type": "string", "enum": ["owner", "tenant", "builder", "craftsman"] },
        "reporterName": { "type": "string", "maxLength": 120 },
        "assignedCraftsmanId": { "type": "string", "maxLength": 128 },
        "assignedCraftsmanName": { "type": "string", "maxLength": 120 },
        "assignedBuilderName": { "type": "string", "maxLength": 120 },
        "estimatedBudget": { "type": "number" },
        "approvedBudget": { "type": "number" },
        "actualCost": { "type": "number" },
        "reportedDate": { "type": "string", "maxLength": 32 },
        "deadlineDate": { "type": "string", "maxLength": 32 },
        "scheduledVisitDate": { "type": "string", "maxLength": 32 },
        "completedDate": { "type": "string", "maxLength": 32 },
        "locationDetail": { "type": "string", "maxLength": 240 },
        "beforePhotos": { "type": "array" },
        "afterPhotos": { "type": "array" },
        "materialsUsed": { "type": "array" },
        "technicianNotes": { "type": "string", "maxLength": 2000 },
        "ownerApprovalNotes": { "type": "string", "maxLength": 2000 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "buildingId", "ownerId", "createdByUid", "memberUids", "invitedEmails", "ticketNumber", "title", "description", "category", "priority", "status", "reporterRole", "reporterName", "estimatedBudget", "reportedDate", "deadlineDate", "locationDetail", "beforePhotos", "afterPhotos", "updatedAt"]
    },
    "ConstructionDefect": {
      "title": "ConstructionDefect",
