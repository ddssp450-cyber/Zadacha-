  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Private user profile and active building selection"
    },
    "/invites/{inviteId}": {
      "schema": { "$ref": "#/entities/BuildingInvite" },
      "description": "Building invitations/enrollments keyed by invite ID"
    },
    "/inviteLookups/{lookupHash}": {
      "schema": { "$ref": "#/entities/InviteLookup" },
      "description": "Zero-PII SHA-256 lookup index mapping identifier hash to invite IDs"
    },
    "/tenantClaims/{userId}": {
      "schema": { "$ref": "#/entities/TenantClaim" },
      "description": "Per-user claim hashes for multi-building lookup verification"
    },
    "/buildings/{buildingId}": {
      "schema": { "$ref": "#/entities/Building" },
      "description": "Building metadata and reserve fund balance"
    },
    "/buildings/{buildingId}/members/{memberUid}": {
      "schema": { "$ref": "#/entities/BuildingMember" },
      "description": "Authoritative role membership per building"
    },
    "/buildings/{buildingId}/apartments/{apartmentId}": {
      "schema": { "$ref": "#/entities/Apartment" },
      "description": "Apartments inside a building"
    },
    "/buildings/{buildingId}/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/PaymentObligation" },
      "description": "Rent and utility payment obligations"
    },
    "/buildings/{buildingId}/appliances/{applianceId}": {
      "schema": { "$ref": "#/entities/Appliance" },
      "description": "Building and apartment appliances"
    },
    "/buildings/{buildingId}/repairTickets/{ticketId}": {
      "schema": { "$ref": "#/entities/RepairTicket" },
      "description": "Repair tickets inside a building"
    },
    "/buildings/{buildingId}/defects/{defectId}": {
      "schema": { "$ref": "#/entities/ConstructionDefect" },
      "description": "Construction warranty defects"
    },
    "/buildings/{buildingId}/calendarEvents/{eventId}": {
      "schema": { "$ref": "#/entities/CalendarEvent" },
      "description": "Scheduled events for a building"
    },
    "/buildings/{buildingId}/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/ExpenseRecord" },
      "description": "Building reserve fund expenses"
    }
  }
}
