        "status": { "type": "string", "enum": ["open", "fixing", "verified_fixed"] },
        "reportedBy": { "type": "string", "maxLength": 120 },
        "reportedAt": { "type": "string", "maxLength": 32 },
        "deadline": { "type": "string", "maxLength": 32 },
        "contractorName": { "type": "string", "maxLength": 160 },
        "photos": { "type": "array" },
        "actionPlan": { "type": "string", "maxLength": 2000 },
        "verifiedAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "format": "date-time" }
